{
  "name": "@literary-universe/cli",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Literary Universe command line tools for authors and local agents",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lu": "dist/main.js"
  },
  "files": [
