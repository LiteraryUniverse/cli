    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@literary-universe/sdk": "0.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  },
  "bundleDependencies": [
    "@literary-universe/sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiteraryUniverse/cli.git"
  },
  "homepage": "https://github.com/LiteraryUniverse/cli#readme",
  "bugs": {
    "url": "https://github.com/LiteraryUniverse/cli/issues"
  }
