  },
  "bundleDependencies": [
    "@literary-universe/sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiteraryUniverse/cli.git"
  },
  "homepage": "https://github.com/LiteraryUniverse/cli#readme",
  "bugs": {
    "url": "https://github.com/LiteraryUniverse/cli/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
